# ------------------------------------------------------------------
# Upwork Radar — environment template
# Copy to `.env.local` and fill in real values. Never commit `.env.local`.
# ------------------------------------------------------------------

# Supabase (public — safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Supabase (server-only — never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# DeepSeek API (server-only)
DEEPSEEK_API_KEY=sk-xxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# App base URL (used for callback + emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000