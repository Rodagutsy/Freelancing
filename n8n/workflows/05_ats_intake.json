                      "id":  "a0002222-3333-4444-5555-666677778888",
                      "name":  "Load Watched Companies",
                      "type":  "n8n-nodes-base.httpRequest",
                      "typeVersion":  4.2,
                      "position":  [
                                       280,
                                       0
                                   ]
                  },
                  {
                      "parameters":  {
                                         "mode":  "runOnceForAllItems",
                                         "jsCode":  "const companies = $input.first().json;\nconst list = Array.isArray(companies) ? companies : (companies ? [companies] : []);\nif (list.length === 0) return [];\n\nreturn list.map(c =\u003e ({ json: c }));"
                                     },
                      "id":  "a0003333-4444-5555-6666-777788889999",
                      "name":  "Split Companies",
                      "type":  "n8n-nodes-base.code",
                      "typeVersion":  2,
                      "position":  [
                                       560,
                                       0
                                   ]
                  },
                  {
                      "parameters":  {
                                         "mode":  "runOnceForAllItems",
                                         "jsCode":  "const company = $input.first().json;\nconst platform = (company.platform || \u0027unknown\u0027).toLowerCase();\nconst url = company.careers_url;\nconst name = company.name;\n\nlet jobs = [];\n\n// Greenhouse board API\nif (platform === \u0027greenhouse\u0027) {\n  const token = company.board_token || \u0027\u0027;\n  const boardSlug = url.match(/boards\\.greenhouse\\.io\\/([\\w.-]+)/)?.[1] || \u0027\u0027;\n  if (!boardSlug) return [];\n  const apiUrl = `https://boards-api.greenhouse.io/v1/boards/${boardSlug}/jobs?content=true`;\n  try {\n    const resp = await fetch(apiUrl);\n    if (!resp.ok) return [];\n    const data = await resp.json();\n    jobs = (data.jobs || []).map(j =\u003e ({\n      title: j.title || \u0027\u0027,\n      description: (j.content || \u0027\u0027).replace(/\u003c[^\u003e]+\u003e/g, \u0027 \u0027).replace(/\\s+/g, \u0027 \u0027).trim().slice(0, 5000),\n      url: j.absolute_url || `https://boards.greenhouse.io/${boardSlug}/jobs/${j.id}`,\n      location: (j.location \u0026\u0026 j.location.name) || \u0027\u0027,\n      skills: (j.departments || []).map(d =\u003e d.name).filter(Boolean),\n      posted_at: j.updated_at || j.created_at || new Date().toISOString(),\n    }));\n  } catch { return []; }\n}\n\n// Lever job board API\nelse if (platform === \u0027lever\u0027) {\n  const leverHost = new URL(url).hostname;\n  const teamSlug = leverHost.replace(\u0027jobs.lever.co/\u0027, \u0027\u0027);\n  const apiUrl = `https://api.lever.co/v0/postings/${teamSlug}?mode=json`;\n  try {\n    const resp = await fetch(apiUrl);\n    if (!resp.ok) return [];\n    const data = await resp.json();\n    jobs = (Array.isArray(data) ? data : []).map(j =\u003e ({\n      title: j.text || \u0027\u0027,\n      description: (j.descriptionPlain || j.description || \u0027\u0027).replace(/\u003c[^\u003e]+\u003e/g, \u0027 \u0027).replace(/\\s+/g, \u0027 \u0027).trim().slice(0, 5000),\n      url: j.hostedUrl || url,\n      location: (j.categories \u0026\u0026 j.categories.location) || \u0027\u0027,\n      skills: (j.tags || []),\n      posted_at: j.createdAt ? new Date(j.createdAt).toISOString() : new Date().toISOString(),\n    }));\n  } catch { return []; }\n}\n\n// Ashby API\nelse if (platform === \u0027ashby\u0027) {\n  const orgSlug = url.match(/ashbyhq\\.com\\/([\\w.-]+)/)?.[1] || \u0027\u0027;\n  if (!orgSlug) return [];\n  const apiUrl = `https://api.ashbyhq.com/posting-api/job-board/${orgSlug}`;\n  try {\n    const resp = await fetch(apiUrl);\n    if (!resp.ok) return [];\n    const data = await resp.json();\n    jobs = (data.jobs || []).map(j =\u003e ({\n      title: j.title || \u0027\u0027,\n      description: (j.descriptionPlain || j.description || \u0027\u0027).replace(/\u003c[^\u003e]+\u003e/g, \u0027 \u0027).replace(/\\s+/g, \u0027 \u0027).trim().slice(0, 5000),\n      url: j.url || url,\n      location: (j.locationName || \u0027\u0027),\n      skills: (j.teamName ? [j.teamName] : []),\n      posted_at: j.publishedAt || new Date().toISOString(),\n    }));\n  } catch { return []; }\n}\n\n// Workable\nelse if (platform === \u0027workable\u0027) {\n  const subdomain = url.match(/([\\w-]+)\\.workable\\.com/)?.[1] || \u0027\u0027;\n  if (!subdomain) return [];\n  const apiUrl = `https://${subdomain}.workable.com/spider/v1/api/accounts/${subdomain}/jobs`;\n  try {\n    const resp = await fetch(apiUrl);\n    if (!resp.ok) return [];\n    const data = await resp.json();\n    jobs = (data.jobs || []).map(j =\u003e ({\n      title: j.title || \u0027\u0027,\n      description: (j.description || \u0027\u0027).replace(/\u003c[^\u003e]+\u003e/g, \u0027 \u0027).replace(/\\s+/g, \u0027 \u0027).trim().slice(0, 5000),\n      url: j.url || url,\n      location: (j.region || j.city || \u0027\u0027),\n      skills: (j.tags || []),\n      posted_at: j.published_at || new Date().toISOString(),\n    }));\n  } catch { return []; }\n}\n\n// SmartRecruiters\nelse if (platform === \u0027smartrecruiters\u0027) {\n  const apiUrl = `https://api.smartrecruiters.com/v1/companies/${encodeURIComponent(name)}/postings?limit=100`;\n  try {\n    const resp = await fetch(apiUrl);\n    if (!resp.ok) return [];\n    const data = await resp.json();\n    jobs = (data.content || []).map(j =\u003e ({\n      title: j.name || \u0027\u0027,\n      description: (j.jobAd \u0026\u0026 j.jobAd.sections \u0026\u0026 j.jobAd.sections.generalDescription || \u0027\u0027).replace(/\u003c[^\u003e]+\u003e/g, \u0027 \u0027).replace(/\\s+/g, \u0027 \u0027).trim().slice(0, 5000),\n      url: j.ref || j.applyUrl || url,\n      location: (j.location \u0026\u0026 j.location.city) || \u0027\u0027,\n      skills: (j.jobAd \u0026\u0026 j.jobAd.sections \u0026\u0026 j.jobAd.sections.employmentExperience || \u0027\u0027).split(\u0027,\u0027).map(s =\u003e s.trim()).filter(Boolean),\n      posted_at: j.releasedDate || new Date().toISOString(),\n    }));\n  } catch { return []; }\n}\n\n// Personio (public API not available â€” skip gracefully)\nelse if (platform === \u0027personio\u0027) {\n  return [];\n}\n\n// Recruitee\nelse if (platform === \u0027recruitee\u0027) {\n  const apiUrl = `https://api.recruitee.com/v1/careers/${company.board_token || name.toLowerCase().replace(/\\s+/g, \u0027\u0027)}/jobs`;\n  try {\n    const resp = await fetch(apiUrl);\n    if (!resp.ok) return [];\n    const data = await resp.json();\n    jobs = (data.jobs || []).map(j =\u003e ({\n      title: j.title || \u0027\u0027,\n      description: (j.description || \u0027\u0027).replace(/\u003c[^\u003e]+\u003e/g, \u0027 \u0027).replace(/\\s+/g, \u0027 \u0027).trim().slice(0, 5000),\n      url: j.url || url,\n      location: (j.location || \u0027\u0027),\n      skills: [],\n      posted_at: j.created_at || new Date().toISOString(),\n    }));\n  } catch { return []; }\n}\n\n// Unknown platform â€” skip\nelse {\n  return [];\n}\n\n// Enrich each job with company metadata\nreturn jobs.map(j =\u003e ({ json: { ...j, company_name: name, careers_url: url } }));"
                                     },
                      "id":  "a0004444-5555-6666-7777-888899990000",
                      "name":  "Fetch Jobs from ATS",
                      "type":  "n8n-nodes-base.code",
                      "typeVersion":  2,
                      "position":  [
                                       840,
                                       0
                                   ]
                  },
                  {
                      "parameters":  {
                                         "mode":  "runOnceForAllItems",
                                         "jsCode":  "// Broad 4-pillar keyword any-match filter.\nconst job = $input.first().json;\nconst text = ((job.title || \u0027\u0027) + \u0027 \u0027 + (job.description || \u0027\u0027) + \u0027 \u0027 + (job.skills || []).join(\u0027 \u0027)).toLowerCase();\n\nconst KEYWORDS = [\n  // design\n  \u0027design\u0027, \u0027ux\u0027, \u0027ui\u0027, \u0027figma\u0027, \u0027product designer\u0027, \u0027web design\u0027,\n  // build\n  \u0027developer\u0027, \u0027engineer\u0027, \u0027full-stack\u0027, \u0027fullstack\u0027, \u0027frontend\u0027, \u0027front-end\u0027,\n  \u0027backend\u0027, \u0027back-end\u0027, \u0027ai\u0027, \u0027llm\u0027, \u0027gpt\u0027, \u0027machine learning\u0027,\n  // automation\n  \u0027automation\u0027, \u0027workflow\u0027, \u0027integration\u0027, \u0027n8n\u0027, \u0027zapier\u0027, \u0027make.com\u0027, \u0027api\u0027, \u0027crm\u0027,\n  // growth\n  \u0027growth\u0027, \u0027marketing\u0027, \u0027seo\u0027, \u0027ads\u0027, \u0027paid media\u0027, \u0027lifecycle\u0027,\n  \u0027email marketing\u0027, \u0027performance marketing\u0027,\n];\n\nconst matched = KEYWORDS.some(kw =\u003e text.includes(kw));\nif (!matched) return [];\n\nreturn [{ json: job }];"
                                     },
                      "id":  "a0005555-6666-7777-8888-999900001111",
                      "name":  "Keyword Filter",
                      "type":  "n8n-nodes-base.code",
                      "typeVersion":  2,
                      "position":  [
                                       1120,
                                       0
                                   ]
                  },
                  {
                      "parameters":  {
                                         "mode":  "runOnceForAllItems",
                                         "jsCode":  "// Normalize an ATS job into the jobs table schema.\nconst input = $input.first().json;\n\nconst isRemote = (input.location || \u0027\u0027).toLowerCase().includes(\u0027remote\u0027)\n  || (input.description || \u0027\u0027).toLowerCase().includes(\u0027remote\u0027);\n\nreturn {\n  json: {\n    source: \u0027ats_api\u0027,\n    raw_payload: input,\n    title: input.title || \u0027Untitled\u0027,\n    description: input.description || \u0027\u0027,\n    skills_requested: Array.isArray(input.skills) ? input.skills : [],\n    budget_min: null,\n    budget_max: null,\n    budget_type: \u0027salary\u0027,\n    client_rating: null,\n    client_reviews_count: null,\n    client_jobs_posted: null,\n    client_hire_rate: null,\n    proposals_count: null,\n    posted_at: input.posted_at || new Date().toISOString(),\n    url: input.url || \u0027\u0027,\n    ingested_at: new Date().toISOString(),\n    company_name: input.company_name || null,\n    location: input.location || null,\n    is_remote: isRemote,\n    user_id: $env.OWNER_USER_ID,\n  }\n};"
                                     },
