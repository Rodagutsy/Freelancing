                      "id":  "e6a0f2c1-9d4b-4b7a-8f2c-3a1e9d0b6c2f",
                      "name":  "Gmail Trigger",
                      "type":  "n8n-nodes-base.gmailTrigger",
                      "typeVersion":  2.2,
                      "position":  [
                                       0,
                                       0
                                   ],
                      "notes":  "Connect your Gmail account (OAuth2) on this node. The search query only matches Upwork saved-search alert emails.\n\nSPEED CONTROL: this node polls Gmail every 1 minute for near-instant intake. But the real bottleneck is Upwork, not n8n: your saved-search alert frequency must be set to IMMEDIATE on Upwork (Job Settings -\u003e Job alerts -\u003e Frequency -\u003e Immediately). If Upwork batches emails, no polling rate will help."
                  },
                  {
                      "parameters":  {
                                         "mode":  "runOnceForAllItems",
                                         "jsCode":  "// Upwork Radar M1 - parse a saved-search alert email into a job object.\n// Input: one Gmail message with fields subject, from, date, textAsHtml, textAsPlain.\n// Output: { job: {..DB columns..} } on success, or { parseError, raw_email, job } if critical fields are missing.\n\nconst email = $input.first().json;\nconst subject = String(email.subject || email.subjectLine || \u0027\u0027);\nconst html = String(email.textAsHtml || email.html || \u0027\u0027);\nconst text = String(email.textAsPlain || email.text || \u0027\u0027).replace(/\\u00a0/g, \u0027 \u0027);\n\nfunction cleanText(value) {\n  return String(value || \u0027\u0027)\n    .replace(/\u003c[^\u003e]+\u003e/g, \u0027 \u0027)\n    .replace(/\u0026nbsp;/g, \u0027 \u0027)\n    .replace(/\u0026amp;/g, \u0027\u0026\u0027)\n    .replace(/\\s+/g, \u0027 \u0027)\n    .trim();\n}\n\n// ---- Title: prefer the subject line ----\nlet title = cleanText(subject)\n  .replace(/^(new job posting( for your search)?|job opportunity|upwork)\\s*[:.\\-]\\s*/i, \u0027\u0027);\nif (!title || title.length \u003c 3) {\n  const m = html.match(/\u003cstrong\u003e\\s*Title\\s*\u003c\\/strong\u003e\\s*\u003c[^\u003e]*\u003e([^\u003c]+)/i)\n    || text.match(/title\\s*[:.-]\\s*(.+)/i);\n  if (m) title = cleanText(m[1]);\n}\n\n// ---- URL: find the \"View Job Posting\" link ----\nlet url = \u0027\u0027;\nconst linkMatch = html.match(/href=\"([^\"]+)\"[^\u003e]*\u003e\\s*(?:view (?:the )?job|job posting|apply now)/i)\n  || html.match(/href=\"(https:\\/\\/www\\.upwork\\.com\\/jobs\\/[^\"]+)\"/i);\nif (linkMatch) url = linkMatch[1].replace(/\u0026amp;/g, \u0027\u0026\u0027);\n\n// ---- Description: strip tags, cut Upwork footer noise ----\nlet description = cleanText(html);\ndescription = description\n  .replace(/\\b(you are receiving this email|this email was sent by upwork|unsubscribe|privacy policy|see more job postings|\\d+\\s+jobs? are currently available)\\b.*$/i, \u0027\u0027)\n  .trim();\nif (!description || description.length \u003c 20) description = cleanText(text);\n\n// ---- Skills (best effort) ----\nlet skills = [];\nconst skillsMatch = text.match(/skills\\s*[:.-]\\s*(.+?)(?:\\n\\s*\\n|\\n\\s*[a-z_]+\\s*:)/is)\n  || html.match(/Skills:\\s*\u003c\\/[^\u003e]+\u003e\\s*(.*?)\u003c/is);\nif (skillsMatch) {\n  skills = cleanText(skillsMatch[1])\n    .split(\u0027,\u0027)\n    .map((s) =\u003e s.trim())\n    .filter(Boolean)\n    .slice(0, 20);\n}\nif (skills.length === 0) {\n  const known = [\u0027n8n\u0027, \u0027GoHighLevel\u0027, \u0027make\u0027, \u0027zapier\u0027, \u0027api\u0027, \u0027automation\u0027, \u0027javascript\u0027, \u0027python\u0027, \u0027react\u0027, \u0027wordpress\u0027, \u0027shopify\u0027, \u0027ai\u0027, \u0027gpt\u0027, \u0027openai\u0027, \u0027google sheets\u0027, \u0027webflow\u0027, \u0027notion\u0027, \u0027airtable\u0027, \u0027chatgpt\u0027, \u0027prompt\u0027, \u0027workflow\u0027, \u0027saas\u0027];\n  skills = known.filter((s) =\u003e new RegExp(\u0027\\\\b\u0027 + s + \u0027\\\\b\u0027, \u0027i\u0027).test(text));\n}\n\n// ---- Budget ----\nlet budgetType = null, budgetMin = null, budgetMax = null;\nconst hourly = text.match(/hourly\\s*[:.-]?\\s*\\$?\\s*(\\d+(?:\\.\\d+)?)\\s*-\\s*\\$?\\s*(\\d+(?:\\.\\d+)?)\\s*\\/\\s*hr/i)\n  || html.match(/Hourly Range:\\s*\u003c[^\u003e]+\u003e\\s*\\$([\\d.,]+)\\s*-\\s*\\$([\\d.,]+)/i);\nconst fixed = text.match(/budget\\s*[:.-]?\\s*\\$?\\s*(\\d+(?:\\.\\d+)?)\\s*-\\s*\\$?\\s*(\\d+(?:\\.\\d+)?)/i)\n  || html.match(/Budget:\\s*\u003c[^\u003e]+\u003e\\s*\\$([\\d.,]+)\\s*-\\s*\\$([\\d.,]+)/i);\nconst num = (s) =\u003e { const n = parseFloat(String(s || \u0027\u0027).replace(/,/g, \u0027\u0027)); return Number.isFinite(n) ? n : null; };\nif (hourly) { budgetType = \u0027hourly\u0027; budgetMin = num(hourly[1]); budgetMax = num(hourly[2]); }\nelse if (fixed) { budgetType = \u0027fixed\u0027; budgetMin = num(fixed[1]); budgetMax = num(fixed[2]); }\n\n// ---- Client stats ----\nconst rating = text.match(/(\\d(?:\\.\\d)?)\\s*\\(\\s*(\\d+)\\s*reviews?\\s*\\)/i)\n  || html.match(/(\\d(?:\\.\\d)?)\\s*\\(\\s*(\\d+)\\s*reviews?\\s*\\)/i);\nconst clientRating = rating ? num(rating[1]) : null;\nconst clientReviews = rating ? parseInt(rating[2], 10) : null;\nconst jobsPosted = (text.match(/(\\d+)\\s*jobs?\\s*posted/i) || html.match(/(\\d+)\\s*jobs?\\s*posted/i) || [])[1] ?? null;\nconst proposals = (text.match(/(\\d+)\\s*proposals?/i) || html.match(/(\\d+)\\s*proposals?/i) || [])[1] ?? null;\n\n// ---- Posted date ----\nlet postedAt = null;\nconst postedMatch = text.match(/(?:posted|listed)\\s*(?:on\\s*)?([a-z]+\\s+\\d{1,2}[a-z]{2},\\s*\\d{4})/i)\n  || html.match(/Posted on\\s*\u003c[^\u003e]+\u003e\\s*([^\u003c]+)\u003c/i);\nif (postedMatch) {\n  const d = new Date(postedMatch[1]);\n  if (!Number.isNaN(d.getTime())) postedAt = d.toISOString();\n}\n\nconst job = {\n  source: \u0027upwork_email\u0027,\n  raw_payload: { subject, from: email.from, received_at: email.date || email.received || null },\n  title: title || null,\n  description: description || null,\n  skills_requested: skills,\n  budget_min: budgetMin,\n  budget_max: budgetMax,\n  budget_type: budgetType,\n  client_rating: clientRating,\n  client_reviews_count: clientReviews,\n  client_jobs_posted: jobsPosted ? parseInt(jobsPosted, 10) : null,\n  client_hire_rate: null,\n  proposals_count: proposals,\n  posted_at: postedAt || email.date || new Date().toISOString(),\n  url: url || null,\n  ingested_at: new Date().toISOString(),\n  user_id: $env.OWNER_USER_ID\n};\n\nconst missing = [\u0027title\u0027, \u0027url\u0027, \u0027description\u0027].filter((k) =\u003e !job[k]);\nif (missing.length \u003e 0) {\n  return {\n    parseError: \u0027missing fields: \u0027 + missing.join(\u0027, \u0027),\n    raw_email: { subject, text: text.slice(0, 2000), html: html.slice(0, 2000) },\n    job\n  };\n}\nreturn { job };"
                                     },
                      "id":  "f7b1a3d2-0e6f-4a8b-9d3c-4b2f1a0e8c7d",
                      "name":  "Parse Email",
