# ------------------------------------------------------------------
# Upwork Radar — environment template
# Copy to `.env.local` and fill in real values. Never commit `.env.local`.
# ------------------------------------------------------------------

# Supabase (public — safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Supabase (server-only — never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# DeepSeek API (server-only)
DEEPSEEK_API_KEY=sk-xxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# App base URL — used by the n8n outbound-send workflow (12_outbound_send.json)
# to call back into /api/outbounds/report.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel Cron secret (server-only). Set a random string here and in Vercel;
# Vercel Cron sends it as `Authorization: Bearer $CRON_SECRET` when hitting
# /api/intake/run. Also lets you trigger the same route manually with curl.
CRON_SECRET=07S85QcPT4dbLH8a1FERgyOmY3Dw4qfpMWjBKurJ9tANv3xC

# ATS intake tuning (server-only, all optional). Lets you retune the cron /
# external-scheduler cadence without a redeploy. On Vercel Hobby keep the
# per-run cap modest — the 60s function ceiling is the real limit.
#   Poll cadence (external scheduler, e.g. cron-job.org) and this should pair:
#   every 15 min -> 10; every 30 min -> 25.
INTAKE_MAX_COMPANIES=40
INTAKE_MIN_AGE_MINUTES=25
INTAKE_CONCURRENCY=5

# ------------------------------------------------------------------
# n8n (OPTIONAL)
# The app is self-sufficient: job posting, scoring, proposals, resume
# parsing, application answers and cover letters all run in-app.
# Leave every N8N_* var unset to deploy without n8n. Audits and outbound
# sending stay disabled until a URL is configured — they never crash.
# Only set these if you run the optional n8n workflows.
# ------------------------------------------------------------------

# n8n automation user — the auth.users.id that owns all n8n-written rows.
# Find it in Supabase Dashboard -> Authentication -> Users (or `select id from
# auth.users limit 1` in the SQL Editor). Must match the account that the app
# signs in as when OWNER_USER_ID is also used for the app owner.
# Also used to gate the "Run intake (cron mode)" button in Settings — only this
# user can fire a service-role intake from the dashboard. Leave unset in a
# single-user app to let your (only) account run it.
# Also set the same value in n8n/.env
OWNER_USER_ID=1af1f2e5-bf82-41e7-b884-8ec73a2998e3

# n8n instance (locals only — passed through n8n/docker-compose.yml)
N8N_ENCRYPTION_KEY=change-me-32-random-characters
RADAR_EMAIL=you@example.com
RADAR_DASHBOARD_URL=http://localhost:3000