# ------------------------------------------------------------------
# Upwork Radar — environment template
# Copy to `.env.local` and fill in real values. Never commit `.env.local`.
# ------------------------------------------------------------------

# Supabase (public — safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Supabase (server-only — never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# DeepSeek API (server-only)
DEEPSEEK_API_KEY=sk-xxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# App base URL — used by the n8n outbound-send workflow (12_outbound_send.json)
# to call back into /api/outbounds/report.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# n8n webhook URLs (server-only)
N8N_AUDIT_WEBHOOK_URL=http://localhost:5678/webhook/audit
N8N_OUTBOUND_WEBHOOK_URL=http://localhost:5678/webhook/outbound-send

# n8n webhook shared secret — must match the "Header Auth" credential in n8n
N8N_WEBHOOK_SECRET=your-shared-secret-here

# n8n automation user — the auth.users.id that owns all n8n-written rows.
# Find it in Supabase Dashboard -> Authentication -> Users (or `select id from
# auth.users limit 1` in the SQL Editor). Must match the account that the app
# signs in as when OWNER_USER_ID is also used for the app owner.
# Also set the same value in n8n/.env
OWNER_USER_ID=your-auth-user-uuid

# n8n instance (locals only — passed through n8n/docker-compose.yml)
N8N_ENCRYPTION_KEY=change-me-32-random-characters
RADAR_EMAIL=you@example.com
RADAR_DASHBOARD_URL=http://localhost:3000